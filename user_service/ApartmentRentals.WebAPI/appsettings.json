{
  "UsersDatabase": {
    "ConnectionString": "mongodb://mongodb:27017/ApartmentRentalsUsers",
    "DatabaseName": "Users",
    "UserCollectionName": "User"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

   "KafkaProducer": {
    "BootstrapServers": "kafka:9092",
    "ProducerTopic": "user-service-order"
  },

  "KafkaConsumer" : {
    "BootstrapServers": "kafka:9092",
    "ConsumerTopic": "prod-orders"
  },

  "AllowedHosts": "*",

  "RedisCache": {
    "Configuration": "redis:6379,abortConnect=False",
    "InstanceName": "ApartmentRentals:"
  }
}
